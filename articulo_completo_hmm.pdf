(import math) Tj
ET
BT
/F4 7.50 Tf
62.00 494.50 Td
() Tj
ET
BT
/F4 7.50 Tf
62.00 485.00 Td
(def viterbi_decode\(obs, A, B, pi\):) Tj
ET
BT
/F4 7.50 Tf
62.00 475.50 Td
(    T, N = len\(obs\), len\(pi\)) Tj
ET
BT
/F4 7.50 Tf
62.00 466.00 Td
(    log_pi = [math.log\(p\) if p > 0 else -1e12 for p in pi]) Tj
ET
BT
/F4 7.50 Tf
62.00 456.50 Td
(    log_A  = [[math.log\(p\) if p > 0 else -1e12 for p in r] for r in A]) Tj
ET
BT
/F4 7.50 Tf
62.00 447.00 Td
(    log_B  = [[math.log\(p\) if p > 0 else -1e12 for p in r] for r in B]) Tj
ET
BT
/F4 7.50 Tf
62.00 437.50 Td
(    delta = [[0.0] * N for _ in range\(T\)]) Tj
ET
BT
/F4 7.50 Tf
62.00 428.00 Td
(    psi   = [[0] * N for _ in range\(T\)]) Tj
ET
BT
/F4 7.50 Tf
62.00 418.50 Td
(    # 1. Inicializacion) Tj
ET
BT
/F4 7.50 Tf
62.00 409.00 Td
(    for j in range\(N\):) Tj
ET
BT
/F4 7.50 Tf
62.00 399.50 Td
(        delta[0][j] = log_pi[j] + log_B[j][obs[0]]) Tj
ET
BT
/F4 7.50 Tf
62.00 390.00 Td
(    # 2. Recursion) Tj
ET
BT
/F4 7.50 Tf
62.00 380.50 Td
(    for t in range\(1, T\):) Tj
ET
BT
/F4 7.50 Tf
62.00 371.00 Td
(        for j in range\(N\):) Tj
ET
BT
/F4 7.50 Tf
62.00 361.50 Td
(            max_val, best_i = -1e12, 0) Tj
ET
BT
/F4 7.50 Tf
62.00 352.00 Td
(            for i in range\(N\):) Tj
ET
BT
/F4 7.50 Tf
62.00 342.50 Td
(                val = delta[t-1][i] + log_A[i][j] + log_B[j][obs[t]]) Tj
ET
BT
/F4 7.50 Tf
62.00 333.00 Td
(                if val > max_val: max_val, best_i = val, i) Tj
ET
BT
/F4 7.50 Tf
62.00 323.50 Td
(            delta[t][j], psi[t][j] = max_val, best_i) Tj
ET
BT
/F4 7.50 Tf
62.00 314.00 Td
(    # 3. Terminacion y Reconstruccion) Tj
ET
BT
/F4 7.50 Tf
62.00 304.50 Td
(    q_star = [0] * T) Tj
ET
BT
/F4 7.50 Tf
62.00 295.00 Td
(    q_star[T-1] = max\(range\(N\), key=lambda j: delta[T-1][j]\)) Tj
ET
BT
/F4 7.50 Tf
62.00 285.50 Td
(    for t in range\(T-2, -1, -1\):) Tj
ET
BT
/F4 7.50 Tf
62.00 276.00 Td
(        q_star[t] = psi[t+1][q_star[t+1]]) Tj
ET
BT
/F4 7.50 Tf
62.00 266.50 Td
(    return q_star, max\(delta[T-1]\)) Tj
ET
